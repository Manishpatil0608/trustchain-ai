# ==============================================================================
# TrustChain-AI Git Attributes & Line Ending Configuration
# ==============================================================================

# Set default behavior to automatically normalize text files to LF on commit
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.sql text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows batch files must retain CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary formats (Prevent any Git text conversion/corruption)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.pdf binary
*.pptx binary
*.docx binary
*.xlsx binary
*.db binary
*.sqlite binary
