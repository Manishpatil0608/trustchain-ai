# ==============================================================================
# TrustChain-AI Environment Configuration Template (.env.example)
# Copy this file to .env before starting the backend application:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Network Configuration
# ------------------------------------------------------------------------------
# Host interface to bind the FastAPI ASGI server to
# Use 127.0.0.1 for local development, 0.0.0.0 for containerized deployment
APP_HOST=127.0.0.1

# TCP Port for FastAPI backend service (Default: 8050)
APP_PORT=8050

# Enable auto-reload for local development (True/False)
APP_RELOAD=False

# Application title displayed in OpenAPI Swagger docs and telemetry logs
APP_APP_NAME=TrustChain-AI Platform

# ------------------------------------------------------------------------------
# 2. Operational & Logging Configuration
# ------------------------------------------------------------------------------
# Debug mode (enables verbose stack traces and development logs)
APP_DEBUG=False

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_LEVEL=INFO

# Log output format: 'json' for production/SOC ingestion, 'text' for console
APP_LOG_FORMAT=json

# ------------------------------------------------------------------------------
# 3. Persistence & Verifiable Data Registry (VDR)
# ------------------------------------------------------------------------------
# SQLite connection string. Default uses local WAL-mode SQLite database.
# In containerized setups, mount this file path as a volume.
APP_DATABASE_URL=sqlite:///./vdr.db

# ------------------------------------------------------------------------------
# 4. Security, JWT & Authentication Configuration
# ------------------------------------------------------------------------------
# Cryptographic secret key used to sign JWT access tokens (HMAC-SHA256)
# WARNING: Generate a secure random 32+ byte string in production!
APP_AUTH_SECRET=dev_secret_trustchain_ai_capstone_project_2026_key_32_bytes_min!

# Access token lifespan in minutes (Default: 30 minutes)
APP_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token lifespan in days (Default: 7 days)
APP_REFRESH_TOKEN_EXPIRE_DAYS=7

# Brute-force protection: Maximum consecutive failed attempts before account lockout
APP_LOGIN_MAX_ATTEMPTS=5

# Duration of brute-force lockout in minutes (Default: 15 minutes)
APP_LOGIN_LOCKOUT_MINUTES=15

# Automatically seed default development admin user if no accounts exist
# Credentials: username=admin, password=Admin@TrustChain2026!
APP_DEV_AUTO_SEED_ADMIN=True

# ------------------------------------------------------------------------------
# 5. Cross-Origin Resource Sharing (CORS) Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins permitted to call the REST API
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8050,http://127.0.0.1:8050
