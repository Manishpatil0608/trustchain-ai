    %% TrustChain-AI: System Architecture Diagram

    subgraph PresentationLayer["Presentation Layer (React 19 / Vite 8 — Port 5173)"]
        UI_Home["DashboardHome\n(KPI Summary & Real-time Trends)"]
        UI_Explorer["AgentExplorer\n(Registry Table & Trust Badges)"]
        UI_Details["AgentDetails\n(Individual Trust History & Metrics)"]
        UI_Discovery["DiscoveryMatching\n(Capability Search & Ranking)"]
        UI_Analytics["TrustAnalytics\n(Recharts Temporal Visualizations)"]
        UI_Telemetry["TelemetryCenter\n(Submission UI & Event History)"]
        UI_States["StateTransitionMap\n(Live Trust State Visualization)"]
        UI_Authz["AuthorizationVisualizer\n(Dynamic Policy Matrix)"]
        UI_Collab["CollaborationCenter\n(Session Tracking & Dialogue Logs)"]
        UI_Workflow["WorkflowCenter\n(Sequential Workflow Orchestrator)"]
        UI_Identity["IdentityCredentials\n(DID:key Generator & VC Issuance)"]
        UI_Audit["AuditTrail\n(Security & Trust Event Explorer)"]
        UI_Health["SystemHealth\n(FastAPI / VDR / Trust Core Probes)"]
        UI_Users["UserManagement\n(RBAC Admin: ADMIN/OPERATOR/VIEWER)"]
        UI_Theme["Theme & Auth Context\n(Light/Dark Mode, JWT Storage)"]
    end

    subgraph APILayer["API Gateway Layer (FastAPI 0.141 / Uvicorn — Port 8050)"]
        API_Auth["Auth Router (/auth)\n- Login (Argon2id, 5-Strike Lockout)\n- Token Refresh & Rotation (JTI)\n- RBAC: ADMIN, OPERATOR, VIEWER"]
        API_Registry["Registry Router (/registry)\n- Agent Lifecycle Management\n- Capability-Based Discovery\n- Collaboration Sessions\n- Sequential Workflow Engine\n- Telemetry Ingestion Endpoint"]
        API_VDR["VDR Router (/vdr)\n- DID:key Resolution\n- Verifiable Credential Store/Verify"]
        API_Health["Health Endpoint (/health)\n- Component Status & Latency Probe"]
        API_Deps["Security Dependencies\n(get_current_active_user, require_admin)"]
    end

    subgraph TrustIntelligenceLayer["Trust Intelligence Core (In-Process Service Engine)"]
        TI_Engine["TrustEngine\n- Task Success Rate S_i(t)\n- Compliance Rate C_i(t)\n- Latency Penalty L_i(t)\n- Composite Score P_i(t) = 0.6S + 0.3C + 0.1(1-L)\n- EMA Temporal Score T_i(t) = 0.7P + 0.3T(prev)\n- Sliding Window: 10 Telemetry Events"]
        TI_Enforcer["AdaptivePolicyEnforcer\n- TRUSTED (T >= 0.8): All Operations\n- SUSPICIOUS (0.5 <= T < 0.8): Standard Only\n- QUARANTINED (T < 0.5): Block All\n- REVOKED: Terminal Administrative Lockout"]
        TI_Connector["LocalAgentConnector\n- Deterministic Capability Simulation\n  (research, analysis, coding, planning, verification)\n- Optional HTTP Outbound Delegation (Fallback)"]
        TI_Matcher["Discovery & Match Engine\n- match_score = 0.4T + 0.3(r/5) + 0.2σ + 0.1(1-λ)"]
    end

    subgraph IdentityLayer["Identity & Credential Layer (W3C Standards)"]
        ID_DID["DID:key Handler\n- Ed25519 Keypair via PyNaCl\n- Multicodec Prefix (0xED, 0x01)\n- Base58 Multibase (z-prefix)\n- W3C DID Document Generation"]
        ID_VC["Verifiable Credentials\n- W3C VC Data Model v1.1\n- Ed25519Signature2020 Linked Data Proof\n- Canonicalization via PyLD (URDNA2015)"]
    end

    subgraph PersistenceLayer["Persistence Layer (SQLite VDR — vdr.db WAL Mode)"]
        DB_Agents[("agents\n(Registry, Status, Reputation)")]
        DB_Trust[("agent_trust_states\n(T_i Score, State)")]
        DB_Telem[("telemetry_logs\n(Observations, Latency, Compliance)")]
        DB_Audit[("trust_audit_trails\n(Immutable Transition History)")]
        DB_VCs[("stored_vcs\n(LDP Credentials JSON-LD)")]
        DB_Collab[("collaboration_sessions\n& collaboration_events")]
        DB_Workflows[("workflows\n& workflow_nodes")]
        DB_Ratings[("agent_ratings\n(1-5 Scale Feedback)")]
        DB_Users[("users, refresh_tokens\n& security_audit_events")]
    end

    %% Cross-layer connections
    PresentationLayer -->|Axios REST / JWT Bearer| APILayer
    APILayer --> API_Deps
    API_Deps --> TrustIntelligenceLayer
    APILayer --> TrustIntelligenceLayer
    APILayer --> IdentityLayer
    TrustIntelligenceLayer --> PersistenceLayer
    IdentityLayer --> PersistenceLayer
    APILayer --> PersistenceLayer
